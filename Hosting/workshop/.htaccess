<IfModule mod_php.c>
php_value upload_max_filesize 30M
php_value post_max_size 40M
</IfModule>
<IfModule php_module>
php_value upload_max_filesize 30M
php_value post_max_size 40M
</IfModule>
<IfModule php7_module>
php_value upload_max_filesize 30M
php_value post_max_size 40M
</IfModule>
<IfModule php8_module>
php_value upload_max_filesize 30M
php_value post_max_size 40M
</IfModule>
